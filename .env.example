# --- InfluxDB (sensor + alert data) -----------------------------------------
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=cold_chain

# --- Email alerting via Resend -----------------------------------------------
# Server-only. Never prefix these with NEXT_PUBLIC_ or the key ships to the
# browser. Same key as photoportfolio, so it needs FULL ACCESS rather than
# send-only.
RESEND_API_KEY=re_...

# Must be a verified Resend sender. Use the format "Name <you@yourdomain.com>".
ALERT_FROM=ColdChain Monitor <alerts@yourdomain.com>

# Comma-separated is not supported here: one recipient per deployment. Put the
# clinical officer who needs to action a cold-chain breach.
ALERT_TO=you@example.com

# Set to 0 to stop sending without deleting the keys (the alerts UI shows the
# panel as "not configured").
ALERT_EMAIL_ENABLED=1

# Link used in the email body, so links work from a phone on the ward floor.
DASHBOARD_URL=http://localhost:3000

# Set to 1 to log the email instead of sending it. Keep this on until you have
# confirmed the sender domain is verified.
ALERT_EMAIL_DRY_RUN=1
